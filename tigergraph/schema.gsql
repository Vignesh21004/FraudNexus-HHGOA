CREATE VERTEX Customer(PRIMARY_ID id STRING, risk FLOAT)
CREATE VERTEX Account(PRIMARY_ID id STRING, risk FLOAT)
CREATE VERTEX Transaction(PRIMARY_ID id STRING, amount DOUBLE, risk_score FLOAT)
CREATE VERTEX Device(PRIMARY_ID id STRING, risk FLOAT)
CREATE VERTEX IP(PRIMARY_ID id STRING, address STRING)
CREATE VERTEX Merchant(PRIMARY_ID id STRING, category STRING)
CREATE VERTEX FraudCase(PRIMARY_ID id STRING, status STRING, confidence FLOAT)
CREATE VERTEX Evidence(PRIMARY_ID id STRING, category STRING, impact FLOAT)
CREATE VERTEX Action(PRIMARY_ID id STRING, action STRING, approval STRING)
CREATE DIRECTED EDGE OWNS(FROM Customer, TO Account)
CREATE DIRECTED EDGE MADE(FROM Account, TO Transaction)
CREATE DIRECTED EDGE USED(FROM Transaction, TO Device)
CREATE DIRECTED EDGE FROM_IP(FROM Transaction, TO IP)
CREATE DIRECTED EDGE PAID_TO(FROM Transaction, TO Merchant)
CREATE DIRECTED EDGE SHARED_WITH(FROM Device, TO Account)
CREATE DIRECTED EDGE CASE_FOR(FROM FraudCase, TO Transaction)
CREATE DIRECTED EDGE HAS_EVIDENCE(FROM FraudCase, TO Evidence)
CREATE DIRECTED EDGE RECOMMENDS(FROM FraudCase, TO Action)
